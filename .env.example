# Copy this file to .env and replace every REPLACE_WITH_* value before starting.
MYSQL_DATABASE=openbench
MYSQL_USER=openbench
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_APPLICATION_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD

# Frontend is bound to localhost; change only the port number if needed.
OPENBENCH_PORT=8080
